<?xml version = "1.0" encoding = "utf-8" ?>

<component name="Videoscreen" extends="Group">
    <interface>
        <field id="videoContentData" type="assocarray" alwaysNotify="true" onChange = "showVideo" />
        <field id="isFocused" type="boolean" alwaysNotify="true" onChange="setFocus" />
        <field id="keyPressed" type="string" alwaysNotify="true"/>
        <field id="goBack" type = "boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="Videoscreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <children>
        <Rectangle
            id = "videoBackground"
            height = "1080"
            width = "1920"
            translation = "[0,0]"
            color = "#000000"
        />
        <Video
            id = "videoPlayer"
            height = "1080"
            width = "1920"
            translation ="[0,0]"
        />
        <Timer  
            id = "videoTimer"
            duration = "1"
            repeat = "false"
        />
        <Group
            id="buttonsUI"
        >
            <Label
                id ="runTime"
                translation = "[100,985]" 
                width = "100"
            />
            <Rectangle
                id= "grayBarRectangle"
                translation="[200,1000]"
                width="1520"
                height="5"
                color = "#808080"
            />
            <Rectangle
                id= "progreessingBarRectangle"
                translation="[200,1000]"
                width="0"
                height="5"
                color = "#FF0000"
            />
            <Label
                id ="totalDuration"
                translation = "[1725,985]" 
                width = "100"
            />
        </Group>
        <Timer
            id = "buttonsTimer"
            duration = "5"
            repeat = "false"
        />
    </children>
</component>