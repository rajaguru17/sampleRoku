<?xml version = "1.0" encoding = "utf-8" ?>

<component name="Videoscreen" extends="Group">
    <interface>
        <field id="videoContentData" type="assocarray" alwaysNotify="true" onChange = "setVideoData" />
        <field id="isFocused" type="boolean" alwaysNotify="true" onChange="setFocus" />
        <field id="keyPressed" type="string" alwaysNotify="true"/>
        <field id="goBack" type = "boolean" alwaysNotify="true" />
    </interface>
    <script type="text/brightscript" uri="Videoscreen.brs" />
    <script type="text/brightscript" uri="pkg:/source/utils.brs" />
    <children>
        <Rectangle
            id = "videoBackground"
            height = "1080"
            width = "1920"
            translation = "[0,0]"
            color = "#000000"
        />
        <Video
            id = "videoPlayer"
            height = "1080"
            width = "1920"
            translation ="[0,0]"
        />
        <Timer  
            id = "videoTimer"
            duration = "1"
            repeat = "false"
        />
        <Group
            id="UI"
        >
            <Label
                id ="runTime"
                translation = "[100,925]" 
                width = "100"
            />
            <Label
                id = "titleInfo"
                translation = "[100,750]" 
                width = "500"
                height = "115"
            />
            <Label 
                id = "episodeInfo"
                translation = "[100,840]"
                width = "500"
                height = "100"
            />
            <Rectangle
                id= "grayBarRectangle"
                translation="[200,940]"
                width="1520"
                height="5"
                color = "#808080"
            />
            <Rectangle
                id= "progreessingBarRectangle"
                translation="[200,940]"
                width="0"
                height="5"
                color = "#FF0000"
            />
            <Label
                id ="totalDuration"
                translation = "[1725,925]" 
                width = "100"
            />
            <MarkupGrid
                id = "videoButtonsGrid"
                itemComponentName = "videoButtonsGridItem"
                translation = "[750,950]"
                itemSize = "[75,85]"
                itemSpacing = "[20,20]"
                numRows = "1"
                numColumns = "3"
                drawFocusFeedback = "false"
            />
        </Group>
        <Timer
            id = "buttonsTimer"
            duration = "5"
            repeat = "false"
        />
        <Timer
            id = "seekTimer"
            duration = "1"
            repeat = "false"
        />
        <Timer
            id = "moveTimer"
            duration = "0.3"
            repeat = "true"
        />
    </children>
</component>