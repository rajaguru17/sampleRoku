<?xml version="1.0" encoding="UTF-8"?>
<component name="movieRowListItem" extends="Group">
    <interface>
        <field id = "itemContent"  type =  "node"   onChange = "showcontent" />
        <field id = "focusPercent" type = "float" onChange = "showfocus" alwaysNotify = "true"/>
        <field id = "itemHasFocus" type = "boolean" onChange = "showfocus" alwaysNotify = "true"/>
    </interface>
    <script type="text/brightscript" uri="movieRowListItem.brs" />
    <children>
        <Group id = "moviesGridItem">
            <poster
                id = "moviesGridItemPoster"
                translation = "[0,0]"
                width = "400"
                height = "200"
                loadHeight = "400.0"
                loadWidth = "200.0"
                loadDisplayMode = "scaleToFill"
            />
            <Label
                id = "moviesGridItemLabel"
                translation = "[10,170]"
                color = "#ffffff"
            />
        </Group>
    </children>
</component>